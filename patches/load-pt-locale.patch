ENW PT-BR: carregar o locale "pt" em produção.

No n8n 2.1.1 o App.vue apenas chama setLanguage(); nenhum código de produção
carrega um JSON de idioma além do inglês (o carregamento existe só no HMR de dev).
Este patch importa explicitamente locales/pt.json e registra as mensagens com
loadLanguage(), função já exportada pelo próprio @n8n/i18n.

diff --git a/packages/frontend/editor-ui/src/app/App.vue b/packages/frontend/editor-ui/src/app/App.vue
--- a/packages/frontend/editor-ui/src/app/App.vue
+++ b/packages/frontend/editor-ui/src/app/App.vue
@@ -21,7 +21,9 @@
 import { useUsersStore } from '@/features/settings/users/users.store';
 import LoadingView from '@/app/views/LoadingView.vue';
 import { locale, N8nCommandBar } from '@n8n/design-system';
-import { setLanguage } from '@n8n/i18n';
+import { loadLanguage, setLanguage } from '@n8n/i18n';
+import type { LocaleMessages } from '@n8n/i18n';
+import ptMessages from '@n8n/i18n/locales/pt.json';
 // Note: no need to import en.json here; default 'en' is handled via setLanguage
 import { useRootStore } from '@n8n/stores/useRootStore';
 import axios from 'axios';
@@ -124,7 +126,12 @@
 watch(
 	defaultLocale,
 	async (newLocale) => {
-		setLanguage(newLocale);
+		// ENW PT-BR: o n8n 2.1.1 não carrega locales além do inglês em produção
+		if (newLocale === 'pt') {
+			loadLanguage(newLocale, ptMessages as LocaleMessages);
+		} else {
+			setLanguage(newLocale);
+		}

 		axios.defaults.headers.common['Accept-Language'] = newLocale;

